    "qs": "^6.16.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-error-boundary": "^6.1.6",
    "react-i18nify": "~6.4.1",
    "react-qrcode-logo": "^4.1.0",
    "resize-observer-polyfill": "^1.5.1",
    "wasm-feature-detect": "^1.9.0",
    "workbox-core": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1",
    "workbox-window": "^7.4.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tailwindcss/aspect-ratio": "^0.4.2",
    "@tailwindcss/line-clamp": "^0.4.4",
    "@testing-library/cypress": "^10.1.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-legacy": "^8.2.3",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "@vitest/eslint-plugin": "^1.6.27",
    "autoprefixer": "^10.6.1",
    "confusing-browser-globals": "^1.0.11",
    "cypress": "^15.17.0",
    "dotenv": "^8.2.0",
    "es-check": "^9.8.1",
    "eslint": "^9.36.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "mocha": "^11.7.6",
    "mochawesome": "^8.1.1",
    "mochawesome-merge": "^5.1.1",
    "mochawesome-report-generator": "^6.3.2",
    "postcss": "^8.5.31",
    "postcss-flexbugs-fixes": "^5.0.2",
    "postcss-preset-env": "^11.6.1",
    "prettier": "^3.9.10",
    "sass": "^1.79.6",
    "serve": "^14.2.6",
    "tailwindcss": "^3.2.7",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.4",
    "vite-plugin-node-polyfills": "^0.28.0",
    "vite-plugin-pwa": "^2.0.0",
    "vite-plugin-svgr": "^5.2.0",
    "vitest": "^5.0.5",
    "workbox-build": "^7.4.1"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "start": "vite",
    "build": "NODE_ENV=production vite build",
    "postbuild": "es-check es2015 'dist/static/js/*.js' dist/service-worker.js && node scripts/gzip-dist.mjs",
    "test": "vitest run",
    "lint": "eslint . --fix",
    "type-check": "tsc -p tsconfig.json && tsc -p tsconfig.cypress.json && tsc -p tsconfig.node.json",
    "serve": "scripts/serve.sh",
    "test:dev": "vitest run && npm run cy:run",
    "test:unit": "vitest run",
    "test:e2e": "npm run cy:run",
    "test:ci": "vitest run && npm run cy:run",
    "generate-e2e-report": "npm run copy-e2e-assets && npm run merge-e2e-results && npm run create-e2e-html-report",
    "copy-e2e-assets": "rm -rf ./cypress/report && mkdir -p ./cypress/screenshots && mkdir -p ./cypress/videos && mkdir ./cypress/report && cp -r ./cypress/screenshots ./cypress/videos ./cypress/report/",
    "merge-e2e-results": "./node_modules/.bin/mochawesome-merge ./cypress/results/*.json -o ./cypress/results/results.json",
    "create-e2e-html-report": "./node_modules/.bin/marge ./cypress/results/results.json -f index.html -o ./cypress/report --cdn",
    "cy:version": "./node_modules/.bin/cypress version",
    "cy:verify": "./node_modules/.bin/cypress verify",
    "cy:open": "./node_modules/.bin/cypress open",
    "cy:run": "NODE_ENV=test cypress run",
    "poeditor:push": "node src/app/locales/poeditor/push.js",
    "poeditor:pull": "node src/app/locales/poeditor/pull.js",
    "test:watch": "vitest",
    "preview": "vite preview"
  },
  "browserslist": {
    "production": [
      "chrome >= 51",
      "safari >= 8"
    ],
    "development": [
      "chrome >= 51",
      "safari >= 8"
    ]
  }
}
